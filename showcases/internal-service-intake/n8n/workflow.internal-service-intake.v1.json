        "id": "WebhookIntake",
        "name": "Intake Webhook",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2.1,
        "position": [
          220,
          220
        ],
        "webhookId": "internal-service-intake-v1"
      },
      {
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "const headers = $json.headers ?? {};\nconst token = headers['x-intake-token'];\nif (!token || token !== $env.INTERNAL_INTAKE_TOKEN) { throw new Error('unauthorized_webhook'); }\nconst body = $json.body ?? {};\nconst required = ['request_id','requester','service_type','urgency','justification'];\nfor (const key of required) { if (!(key in body)) { throw new Error(`missing_${key}`); } }\nif (!/^REQ-[A-Z0-9-]{3,40}$/.test(body.request_id)) { throw new Error('invalid_request_id'); }\nif (!['analytics','automation','integration','incident-response'].includes(body.service_type)) { throw new Error('invalid_service_type'); }\nif (!['low','medium','high'].includes(body.urgency)) { throw new Error('invalid_urgency'); }\nif (typeof body.justification !== 'string' || body.justification.trim().length < 10 || body.justification.length > 500) { throw new Error('invalid_justification'); }\nconst classification = (body.urgency === 'high' || ['integration','incident-response'].includes(body.service_type)) ? 'expedite_review' : 'standard_review';\nreturn { json: { request_id: body.request_id, requester: body.requester, service_type: body.service_type, urgency: body.urgency, justification: body.justification, classification } };"
        },
        "id": "ValidateIntake",
        "name": "Validate Intake Webhook",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          460,
