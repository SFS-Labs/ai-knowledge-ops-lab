      {
        "id": "ValidateText",
        "name": "Validate Text Webhook",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          460,
          860
        ],
        "parameters": {
          "mode": "runOnceForEachItem",
          "jsCode": "const headers = $json.headers ?? {};\nif (headers['x-intake-token'] !== $env.INTERNAL_INTAKE_TOKEN || !$env.INTERNAL_INTAKE_TOKEN) {\n  throw new Error('unauthorized_text_webhook');\n}\nconst body = $json.body;\nif (!body || typeof body !== 'object' || Array.isArray(body)) { throw new Error('invalid_body'); }\nif (typeof body.request_id !== 'string' || !/^REQ-[A-Z0-9-]{3,40}$/.test(body.request_id)) {\n  throw new Error('invalid_request_id');\n}\nif (typeof body.requester !== 'string' || !body.requester.trim() || body.requester.length > 80) {\n  throw new Error('invalid_requester');\n}\nif (typeof body.free_text !== 'string' || body.free_text.trim().length < 10 || body.free_text.length > 1200 ||\n    /[\\u0000-\\u0008\\u000b\\u000c\\u000e-\\u001f]/.test(body.free_text)) {\n  throw new Error('invalid_free_text');\n}\nreturn { json: { request_id: body.request_id, requester: body.requester, free_text: body.free_text } };"
        }
